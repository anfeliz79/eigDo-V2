[Unit]
Description=eigdo Admin Panel (Next.js)
After=network.target

[Service]
WorkingDirectory=/opt/eigdo/frontend/admin
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=eigdo-admin
User=eigdo
Group=eigdo
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=HOSTNAME=0.0.0.0
EnvironmentFile=/opt/eigdo/config/.env.admin

[Install]
WantedBy=multi-user.target
