[Unit]
Description=eigdo Landing Page (Next.js)
After=network.target

[Service]
WorkingDirectory=/opt/eigdo/frontend/landing
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=eigdo-landing
User=eigdo
Group=eigdo
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=0.0.0.0
EnvironmentFile=/opt/eigdo/config/.env.landing

[Install]
WantedBy=multi-user.target
