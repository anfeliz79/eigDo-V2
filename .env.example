# Database
DATABASE_CONNECTION=Host=localhost;Port=5432;Database=eigdo_dev;Username=eigdo;Password=change_me

# Redis
REDIS_CONNECTION=localhost:6379

# JWT
JWT_SECRET=generate_a_long_random_secret_here_at_least_64_characters
JWT_ISSUER=eigdo
JWT_AUDIENCE=eigdo-clients
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=30

# Encryption
ENCRYPTION_KEY=generate_a_32_byte_base64_key_here

# Alanube
ALANUBE_BASE_URL=https://sandbox.alanube.co/dom/v1
